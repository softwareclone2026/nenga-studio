{
  "name": "nenga-studio",
  "productName": "年賀スタジオ",
  "version": "1.0.0",
  "description": "年賀状ソフト（Windows / Linux / macOS）。住所録・文面デザイン・宛名印刷。",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node tools/self-check.js",
    "render": "electron tools/render-samples.js",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.softwareclone.nengastudio",
    "productName": "年賀スタジオ",
    "asar": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "fileAssociations": [
      {
        "ext": "nenga",
        "name": "年賀状プロジェクト",
        "role": "Editor"
      }
    ]
  }
}
